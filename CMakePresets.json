{
  "version": 3,
  "configurePresets": [
    {
      "name": "clang-asan",
      "generator": "Ninja",
      "binaryDir": "build_clang_asan",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g",
        "CMAKE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ]
}